# Dependencies
node_modules/

# Build output
dist/
*.js
*.js.map
*.d.ts
!src/**/*.js

# Keep TypeScript source
!*.ts

# Lock files (keep package-lock.json for npm users)
# bun.lock

# Environment files
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# User runtime data — never commit. Actual memories/config live under
# ~/.squire and ~/.squirebot (outside this repo). src/memory/ is application
# source for the memory engine, not private user files.
.squire/
.squirebot/

# Runtime data dirs only at the repo root (not src/memory/)
workspaces.json
tickets.db
scheduler.db
/memory/
MEMORY.md
daily-logs/

# Temporary files
*.tmp
*.temp
.cache/

# Database files (user data)
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
bun.lock

# DisCode runner-agent session files (not part of Squire)
/CLAUDE.md
/CLAUDE.md.discode-inactive
/.claude/skills/
/.claude/skills.inactive/
/.codex/skills/
/.codex/skills.inactive/
